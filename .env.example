# Copy to .env and fill in. None of the data sources need an API key.

# Base currency for the forex scraper
FOREX_BASE=USD

# Failure alerts. Leave ALERT_EMAIL empty to disable them.
# For Gmail, SMTP_PASSWORD must be an app password: https://myaccount.google.com/apppasswords
ALERT_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
